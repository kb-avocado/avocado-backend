<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.avocado.domain.notification.mapper.NotificationMapper">
    <insert id="insert"
            parameterType="com.avocado.domain.notification.domain.NotificationVo"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">
        INSERT INTO notifications (
            receiver_id,
            type,
            title,
            message,
            is_read,
            created_at
        ) VALUES (
            #{receiverId},
            #{type},
            #{title},
            #{message},
            #{isRead},
            #{createdAt}
        )
    </insert>
</mapper>