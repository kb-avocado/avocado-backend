<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.avocado.domain.transaction.mapper.AccountTxMapper">

    <!--  부모 계좌에서 아이 선불지갑으로 송금한 계좌 거래 이력을 기록  -->
    <insert id="insertWalletChargeHistory">
        INSERT INTO account_histories (
            account_id,
            trace_id,
            transaction_type,
            amount,
            status,
            failure_code
        )
        VALUES (
            #{accountId},
            #{traceId},
            'WITHDRAWAL',
            #{amount},
            'SUCCESS',
            NULL
        )
    </insert>

</mapper>