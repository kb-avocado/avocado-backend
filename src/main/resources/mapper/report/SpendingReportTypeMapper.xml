<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.avocado.domain.report.mapper.SpendingReportTypeMapper">

    <resultMap id="spendingReportTypeMap" type="com.avocado.domain.report.domain.SpendingReportType">
        <id property="id" column="id"/>
        <result property="code" column="code"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
    </resultMap>

    <select id="findByCode" resultMap="spendingReportTypeMap">
        SELECT id, code, name, description
        FROM spending_report_types
        WHERE code = #{code}
    </select>

</mapper>