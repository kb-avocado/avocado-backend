<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.avocado.user.mapper.UserMapper">

    <select id="selectByEmail" resultType="com.avocado.user.domain.User">
        SELECT user_id,
               email,
               password,
               name,
               phone,
               birth,
               user_type,
               role,
               status,
               invite_code,
               created_at,
               updated_at
          FROM users
         WHERE email = #{email}
    </select>

</mapper>
