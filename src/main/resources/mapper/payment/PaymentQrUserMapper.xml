<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.avocado.domain.payment.mapper.PaymentQrUserMapper">

    <select id="findNamesByIds" resultType="com.avocado.domain.user.domain.UserVo">
        SELECT
            id,
            name
        FROM users
        WHERE id IN
        <foreach item="userId" collection="userIds" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </select>

</mapper>
